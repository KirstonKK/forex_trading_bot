# Forex Trading Bot — Environment Configuration
#
# SETUP: Run the setup script to create this file automatically:
#   bash scripts/setup_env.sh
#
# OR manually copy and edit:
#   cp deployment/forex-bot.env.example forex-bot.env
#   chmod 600 forex-bot.env
#   # Then edit forex-bot.env and fill in real values

# Required — webhook authentication (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
WEBHOOK_SECRET=replace_with_a_long_random_secret

# Telegram Bot (@Jarvis_kkbot) — enables trade alerts and status notifications
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_personal_chat_id
TELEGRAM_GROUP_ID=your_group_chat_id
