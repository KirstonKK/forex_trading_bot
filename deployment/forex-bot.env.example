# Copy to /etc/jarvis/forex-bot.env and secure permissions:
#   sudo mkdir -p /etc/jarvis
#   sudo cp deployment/forex-bot.env.example /etc/jarvis/forex-bot.env
#   sudo chmod 600 /etc/jarvis/forex-bot.env

# Required
WEBHOOK_SECRET=replace_with_a_long_random_secret

# Optional (enables Telegram notifications when both are set)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_GROUP_ID=
