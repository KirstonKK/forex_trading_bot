[Unit]
Description=Jarvis Forex Bot - Webhook Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vanhansen53
WorkingDirectory=/home/vanhansen53/forex_trading_bot
Environment="PATH=/home/vanhansen53/.pyenv/versions/3.10.19/envs/forex-bot/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/etc/jarvis/forex-bot.env
ExecStart=/home/vanhansen53/.pyenv/versions/3.10.19/envs/forex-bot/bin/python3 scripts/tradingview_webhook_server.py
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60
StandardOutput=append:/home/vanhansen53/forex_trading_bot/logs/webhook.log
StandardError=append:/home/vanhansen53/forex_trading_bot/logs/webhook_error.log

[Install]
WantedBy=multi-user.target
