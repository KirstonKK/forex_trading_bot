[Unit]
Description=Jarvis Forex Bot - Main Bot Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vanhansen53
WorkingDirectory=/home/vanhansen53/forex_trading_bot
Environment="PATH=/home/vanhansen53/.pyenv/versions/3.10.19/envs/forex-bot/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/home/vanhansen53/forex_trading_bot/forex-bot.env
ExecStart=/bin/bash /home/vanhansen53/forex_trading_bot/scripts/jarvis_service.sh
Restart=always
RestartSec=10
StandardOutput=append:/home/vanhansen53/forex_trading_bot/logs/service.log
StandardError=append:/home/vanhansen53/forex_trading_bot/logs/service_error.log

[Install]
WantedBy=multi-user.target
