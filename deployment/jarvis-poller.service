[Unit]
Description=Jarvis Forex Bot - Live Data Poller
After=network-online.target jarvis-webhook.service
Wants=network-online.target

[Service]
Type=simple
User=vanhansen53
WorkingDirectory=/home/vanhansen53/forex_trading_bot
Environment="PATH=/home/vanhansen53/.pyenv/versions/3.10.19/envs/forex-bot/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/etc/jarvis/forex-bot.env
ExecStart=/home/vanhansen53/.pyenv/versions/3.10.19/envs/forex-bot/bin/python3 scripts/live_data_poller.py
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60
StandardOutput=append:/home/vanhansen53/forex_trading_bot/logs/poller.log
StandardError=append:/home/vanhansen53/forex_trading_bot/logs/poller_error.log

[Install]
WantedBy=multi-user.target
